# =============================================================================
# Produccion — Intelligent Automotive Diagnostics
# =============================================================================
# Copiar a .env y rellenar los secretos antes de hacer deploy.
# NUNCA commitear este archivo con secretos reales.
# =============================================================================

# --- OBD ---
OBD_MODE=docker

# --- LLM (obligatorio) ---
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-key-here
# LLM_BASE_URL=   # descomentar para proveedores compatibles (DeepSeek, Groq...)
# LLM_MODEL=      # por defecto gpt-4o con openai, claude-3-5-sonnet con anthropic

# --- JWT (obligatorio — generar con: openssl rand -hex 64) ---
ACCESS_TOKEN_SECRET=changeme
REFRESH_TOKEN_SECRET=changeme

# --- Web / CORS ---
APP_BASE_URL=https://diag.jcodinglabs.com
ALLOWED_ORIGINS=https://diag.jcodinglabs.com

# --- SMTP (recuperación de contraseña — IONOS) ---
SMTP_HOST=smtp.ionos.es
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@jcodinglabs.com
SMTP_PASS=changeme
SMTP_FROM=no-reply@jcodinglabs.com

# --- UI ---
UI_PORT=8080
