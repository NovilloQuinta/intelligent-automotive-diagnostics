# OBD mode:
#   docker = emulador local con 3 escenarios (demo web)
#   serial = adaptador ELM327 real por cable USB (coche real, portatil)
#   tcp    = adaptador ELM327 real por WiFi
OBD_MODE=docker

# Docker emulador — escenarios por vehiculo
# Audi A3 2.0 TDI (puerto 35000)
ELM327_AUDI_HOST=localhost
ELM327_AUDI_PORT=35000

# Kawasaki Z900 (puerto 35001)
ELM327_KAWASAKI_HOST=localhost
ELM327_KAWASAKI_PORT=35001

# Toyota (built-in, puerto 35002)
ELM327_TOYOTA_HOST=localhost
ELM327_TOYOTA_PORT=35002

# Modo TCP: host/puerto del dispositivo ELM327 real (solo si OBD_MODE=tcp)
# Los dongles WiFi suelen levantar su propia red en 192.168.0.10:35000
ELM327_HOST=localhost
ELM327_PORT=35000

# Seguimiento en vivo: pinta por consola cada comando enviado al adaptador y su
# respuesta cruda, con el tiempo que tardo. No guarda nada en ningun sitio.
# Util al trabajar sobre el coche; dejalo en false en la demo web.
OBD_TRACE=false

# Bloquea el borrado de DTC (Mode 04), que en un coche real es irreversible:
# elimina codigos y freeze frames y reinicia los monitores de emisiones.
# Ponlo a true al trabajar sobre el vehiculo. Los servicios de control (2F, 31,
# 11, 2E...) estan bloqueados siempre, con independencia de esta variable.
OBD_READ_ONLY=false

# Modo SERIAL: adaptador ELM327 por USB (solo si OBD_MODE=serial)
# Descubre ambos valores con el adaptador enchufado: pnpm obd:probe
# Clones CH340 aparecen como /dev/ttyUSB0; los STN como /dev/ttyACM0.
SERIAL_PORT_PATH=/dev/ttyUSB0
SERIAL_BAUD_RATE=38400

# LLM Provider — "anthropic" o "openai"
# openai: compatible con OpenAI, DeepSeek, Groq, Mistral, xAI...
LLM_PROVIDER=openai

# LLM API key para el proveedor elegido
LLM_API_KEY=

# URL base del proveedor (solo para openai — por defecto https://api.openai.com/v1)
LLM_BASE_URL=

# Modelo a usar (por defecto gpt-4o para openai)
LLM_MODEL=

# Anthropic API key (solo si LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# SQLite database path
DB_PATH=data/diagnostics.db

# HTTP server port
PORT=4000

# JWT secrets (must be changed in production)
ACCESS_TOKEN_SECRET=changeme
REFRESH_TOKEN_SECRET=changeme

# SMTP (password recovery emails) — generic SMTP, no hardcoded provider.
# If SMTP_HOST is unset, emails are logged to console instead of sent (dev/CI default).
# Example for an IONOS mailbox: SMTP_HOST=smtp.ionos.es (or smtp.ionos.com), port 587 + STARTTLS
# (SMTP_SECURE=false) or port 465 + SSL (SMTP_SECURE=true).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@localhost

# Base URL of the frontend app, used to build the password reset link
APP_BASE_URL=http://localhost:5173

# TTL (minutes) of a password reset token before it expires
PASSWORD_RESET_TTL_MINUTES=60

# LanceDB vector database path (embedded, same process as core-api)
# LANCEDB_PATH=data/lancedb

# Web search API key (SerpAPI) — optional, enables web_search MCP tool
# WEB_SEARCH_API_KEY=
