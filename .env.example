# OBD emulator (ELM327)
ELM327_HOST=localhost
ELM327_PORT=35000

# OBD mode: "sync" (built-in simulator) or "tcp" (external emulator)
OBD_MODE=sync

# LLM Provider — "anthropic" o "openai"
# openai: compatible con OpenAI, DeepSeek, Groq, Mistral, xAI...
LLM_PROVIDER=openai

# LLM API key para el proveedor elegido
LLM_API_KEY=

# URL base del proveedor (solo para openai — por defecto https://api.openai.com/v1)
LLM_BASE_URL=

# Modelo a usar (por defecto gpt-4o para openai)
LLM_MODEL=

# Anthropic API key (solo si LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# SQLite database path
DB_PATH=data/diagnostics.db

# HTTP server port
PORT=4000

# JWT secrets (must be changed in production)
ACCESS_TOKEN_SECRET=changeme
REFRESH_TOKEN_SECRET=changeme
