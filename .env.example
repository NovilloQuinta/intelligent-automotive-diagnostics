# OBD emulator (ELM327)
ELM327_HOST=localhost
ELM327_PORT=35000

# OBD mode: "sync" (built-in simulator) or "tcp" (external emulator)
OBD_MODE=sync

# LLM Provider — "anthropic" o "openai"
# openai: compatible con OpenAI, DeepSeek, Groq, Mistral, xAI...
LLM_PROVIDER=openai

# LLM API key para el proveedor elegido
LLM_API_KEY=

# URL base del proveedor (solo para openai — por defecto https://api.openai.com/v1)
LLM_BASE_URL=

# Modelo a usar (por defecto gpt-4o para openai)
LLM_MODEL=

# Anthropic API key (solo si LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# SQLite database path
DB_PATH=data/diagnostics.db

# HTTP server port
PORT=4000

# JWT secrets (must be changed in production)
ACCESS_TOKEN_SECRET=changeme
REFRESH_TOKEN_SECRET=changeme

# SMTP (password recovery emails) — generic SMTP, no hardcoded provider.
# If SMTP_HOST is unset, emails are logged to console instead of sent (dev/CI default).
# Example for an IONOS mailbox: SMTP_HOST=smtp.ionos.es (or smtp.ionos.com), port 587 + STARTTLS
# (SMTP_SECURE=false) or port 465 + SSL (SMTP_SECURE=true).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@localhost

# Base URL of the frontend app, used to build the password reset link
APP_BASE_URL=http://localhost:5173

# TTL (minutes) of a password reset token before it expires
PASSWORD_RESET_TTL_MINUTES=60
