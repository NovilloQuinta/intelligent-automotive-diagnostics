# OBD mode: "docker" (emulador local) o "tcp" (dispositivo OBD real)
OBD_MODE=docker

# Docker emulador — escenarios por vehiculo
# Audi A3 2.0 TDI (puerto 35000)
ELM327_AUDI_HOST=localhost
ELM327_AUDI_PORT=35000

# Kawasaki Z900 (puerto 35001)
ELM327_KAWASAKI_HOST=localhost
ELM327_KAWASAKI_PORT=35001

# Toyota (built-in, puerto 35002)
ELM327_TOYOTA_HOST=localhost
ELM327_TOYOTA_PORT=35002

# Modo TCP: host/puerto del dispositivo ELM327 real (solo si OBD_MODE=tcp)
ELM327_HOST=localhost
ELM327_PORT=35000

# LLM Provider — "anthropic" o "openai"
# openai: compatible con OpenAI, DeepSeek, Groq, Mistral, xAI...
LLM_PROVIDER=openai

# LLM API key para el proveedor elegido
LLM_API_KEY=

# URL base del proveedor (solo para openai — por defecto https://api.openai.com/v1)
LLM_BASE_URL=

# Modelo a usar (por defecto gpt-4o para openai)
LLM_MODEL=

# Anthropic API key (solo si LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# SQLite database path
DB_PATH=data/diagnostics.db

# HTTP server port
PORT=4000

# JWT secrets (must be changed in production)
ACCESS_TOKEN_SECRET=changeme
REFRESH_TOKEN_SECRET=changeme
